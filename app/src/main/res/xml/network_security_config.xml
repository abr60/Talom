<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Base: disallow cleartext for all domains -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    <!-- Allow cleartext only for loopback / emulator + LAN — required for local Ollama -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">192.168.0.111</domain>
        <domain includeSubdomains="false">192.168.1.1</domain>
        <domain includeSubdomains="false">192.168.0.1</domain>
    </domain-config>
    <!-- Also allow any private-network host via base override for local LLM: -->
    <!-- If laptop IP changes (DHCP), add it above or set base cleartext true temporarily. -->
</network-security-config>
